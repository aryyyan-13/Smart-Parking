# ──────────────────────────────────────────────────────────────────────────────
# Smart Parking — API environment variables
# Copy this file to .env and fill in every value.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Node ──────────────────────────────────────────────────────────────────────
# Application environment: development | test | staging | production
NODE_ENV=development

# Port the Express server listens on
PORT=3001

# ── Database (Supabase Postgres) ───────────────────────────────────────────────
# Connection string for Prisma. Use the "Transaction" pooler URL from
# Supabase → Project → Settings → Database → Connection pooling.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.tjwbuarkrciiyrcbnkzx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection — used by Prisma Migrate (bypasses PgBouncer).
# Supabase → Project → Settings → Database → Direct connection string.
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.tjwbuarkrciiyrcbnkzx.supabase.co:5432/postgres

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Supabase → Project → Settings → API

# Your Supabase project URL
SUPABASE_URL=https://tjwbuarkrciiyrcbnkzx.supabase.co

# The anon/public key — safe for the browser but also used here to verify JWTs
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# The service_role key — NEVER expose this to the browser.
# Used only in the Express API for admin operations (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# JWT secret — Supabase → Project → Settings → API → JWT Settings → JWT Secret
# Used to verify tokens without a Supabase round-trip.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── Supabase Storage ───────────────────────────────────────────────────────────
# Name of the storage bucket for listing photos (create in Supabase → Storage).
STORAGE_BUCKET_LISTINGS=listing-photos

# ── Google Maps (server-side only) ────────────────────────────────────────────
# A Google Maps API key restricted to the Geocoding API only.
# Do NOT use the browser key here.
GOOGLE_GEOCODING_KEY=your-server-side-geocoding-key-here

# ── Resend (email) ────────────────────────────────────────────────────────────
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# The "from" address for all transactional emails (must be a verified domain).
EMAIL_FROM=noreply@yourdomain.com

# ── Sentry ────────────────────────────────────────────────────────────────────
# Sentry DSN for the API — Sentry → Project → Settings → SDK Setup
SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Example: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Application ───────────────────────────────────────────────────────────────
# How long a PENDING manual-approval booking is reserved before expiring.
# Value in minutes. Default: 30
PENDING_BOOKING_EXPIRY_MINUTES=30

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug
